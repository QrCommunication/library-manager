{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Library Manager main window: native file selection and HTTP(S) links.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" }
      ]
    }
  ]
}
